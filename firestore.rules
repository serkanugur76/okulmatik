rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function kullaniciBilgisi() {
      return get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data;
    }
    function platformAdmin() {
      return kullaniciBilgisi().rol == 'platform_admin';
    }

    // Alt koleksiyonlar için: kurumlar dokümanını okuyup rootKurumId kontrolü
    function kurumUyesi(kurumId) {
      let k = kullaniciBilgisi();
      let kurum = get(/databases/$(database)/documents/kurumlar/$(kurumId)).data;
      return k.kurumId == kurumId || k.kurumId == kurum.rootKurumId;
    }
    function kurumAdmin(kurumId) {
      return kullaniciBilgisi().rol == 'kurum_admin' && kurumUyesi(kurumId);
    }

    match /yetkiliKullanicilar/{email} {
      allow read:  if (request.auth != null && request.auth.token.email == email) || platformAdmin();
      allow write: if platformAdmin();
    }

    match /kullanicilar/{uid} {
      allow read:  if request.auth.uid == uid || platformAdmin();
      allow write: if request.auth.uid == uid || platformAdmin()
                   || (kurumAdmin(kullaniciBilgisi().kurumId) && request.resource.data.kurumId == kullaniciBilgisi().kurumId);
    }
    match /platform/kurumlar/{kurumId} {
      allow read:  if platformAdmin() || kurumAdmin(kurumId);
      allow write: if platformAdmin();
    }
    match /kurumlar/{kurumId} {
      // resource.data kullanılır — get() çağrısı gerektirmez, collection query'de çalışır
      allow read:  if platformAdmin()
        || kullaniciBilgisi().kurumId == kurumId
        || kullaniciBilgisi().kurumId == resource.data.rootKurumId;
      allow write: if platformAdmin()
        || (kullaniciBilgisi().rol == 'kurum_admin'
            && (kullaniciBilgisi().kurumId == kurumId
                || kullaniciBilgisi().kurumId == resource.data.rootKurumId));
    }
    match /kurumlar/{kurumId}/siniflar/{sinifId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }
    match /kurumlar/{kurumId}/ogrenciler/{ogrenciId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }
    match /kurumlar/{kurumId}/moduller/{modulId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }
    // Platform seviyesinde rubrik şablonları
    match /rubrikSablonlar/{sablonId} {
      allow read:  if request.auth != null;   // tüm giriş yapmış kullanıcılar okuyabilir
      allow write: if platformAdmin();         // sadece platform admin yazabilir
    }
    match /kurumlar/{kurumId}/rubrikler/{rubrikId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }
    match /kurumlar/{kurumId}/puanlar/{kayitId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow create: if kurumUyesi(kurumId) || platformAdmin();
      allow update: if kurumUyesi(kurumId) || platformAdmin();
    }
    match /kurumlar/{kurumId}/yorumlar/{yorumId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow write: if kurumUyesi(kurumId) || platformAdmin();
    }
    match /kurumlar/{kurumId}/raporlar/{raporId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }
    match /kurumlar/{kurumId}/kullanicilar/{uid} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }
  }
}
