rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function kullaniciBilgisi() {
      return get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data;
    }
    function platformAdmin() {
      return kullaniciBilgisi().rol == 'platform_admin';
    }

    // Kurum hiyerarşisi: kendi kurumu, root admin, parent admin
    function kurumUyesi(kurumId) {
      let k = kullaniciBilgisi();
      let kurum = get(/databases/$(database)/documents/kurumlar/$(kurumId)).data;
      return k.kurumId == kurumId
          || k.kurumId == kurum.rootKurumId
          || k.kurumId == kurum.parentId;
    }
    function kurumAdmin(kurumId) {
      return kullaniciBilgisi().rol == 'kurum_admin' && kurumUyesi(kurumId);
    }

    function kullanicininKurumTip() {
      return get(/databases/$(database)/documents/kurumlar/$(kullaniciBilgisi().kurumId)).data.tip;
    }
    function kullanicininRootKurumId() {
      let kulKurum = get(/databases/$(database)/documents/kurumlar/$(kullaniciBilgisi().kurumId)).data;
      return kulKurum.get('rootKurumId', kullaniciBilgisi().kurumId);
    }
    function kullanicininParentKurumId() {
      return get(/databases/$(database)/documents/kurumlar/$(kullaniciBilgisi().kurumId)).data.get('parentId', '');
    }

    // Aynı organizasyon: rubrik gibi paylaşılan kaynaklar için
    function ayniOrganizasyon(kurumId) {
      let hedefRootId = get(/databases/$(database)/documents/kurumlar/$(kurumId)).data.get('rootKurumId', kurumId);
      return kullanicininRootKurumId() == hedefRootId
          || kullanicininRootKurumId() == kurumId;
    }

    // Öğretmen: erisimKurumIdler içinde bu kurum var mı?
    function ogretmenKurumErisimi(kurumId) {
      return kullaniciBilgisi().rol == 'ogretmen'
          && kurumId in kullaniciBilgisi().get('erisimKurumIdler', []);
    }

    // Öğretmen: parent (kampüs) kurum dokümanını okuyabilir (görüntüleme için)
    function ogretmenParentOkuma(kurumId) {
      return kullaniciBilgisi().rol == 'ogretmen'
          && kurumId in kullaniciBilgisi().get('parentKurumIdler', []);
    }

    // Öğretmen: hem kurum erişimi var hem de ilgili sınıf atamalı mı?
    function ogretmenSinifErisimi(kurumId, sinifId) {
      return kullaniciBilgisi().rol == 'ogretmen'
          && kurumId in kullaniciBilgisi().get('erisimKurumIdler', [])
          && sinifId in kullaniciBilgisi().get('sinifIdler', []);
    }

    // altKurum admini sadece 'ogretmen' rolünde kullanıcı yazabilir
    function rolYazmaIzni() {
      return platformAdmin()
          || kullanicininKurumTip() != 'altKurum'
          || request.resource.data.rol == 'ogretmen';
    }

    // ── Koleksiyonlar ────────────────────────────────────────

    match /yetkiliKullanicilar/{email} {
      allow read:   if (request.auth != null && request.auth.token.email == email)
                    || platformAdmin()
                    || (kullaniciBilgisi().rol == 'kurum_admin' && kurumUyesi(resource.data.kurumId));
      allow create, update: if platformAdmin()
                    || (kullaniciBilgisi().rol == 'kurum_admin'
                        && kurumUyesi(request.resource.data.kurumId)
                        && rolYazmaIzni());
      allow delete: if platformAdmin()
                    || (request.auth != null && request.auth.token.email == email)
                    || (kullaniciBilgisi().rol == 'kurum_admin' && kurumUyesi(resource.data.kurumId));
    }

    match /kullanicilar/{uid} {
      allow read:  if request.auth.uid == uid || platformAdmin();
      allow write: if request.auth.uid == uid || platformAdmin()
                   || (kullaniciBilgisi().rol == 'kurum_admin'
                       && kurumUyesi(request.resource.data.kurumId)
                       && rolYazmaIzni());
    }

    match /platform/kurumlar/{kurumId} {
      allow read:  if platformAdmin() || kurumAdmin(kurumId);
      allow write: if platformAdmin();
    }

    match /kurumlar/{kurumId} {
      allow read:  if platformAdmin()
        || kullaniciBilgisi().kurumId == kurumId
        || kullaniciBilgisi().kurumId == resource.data.rootKurumId
        || kullaniciBilgisi().kurumId == resource.data.parentId
        || kullanicininRootKurumId() == kurumId
        || kullanicininParentKurumId() == kurumId
        || ogretmenKurumErisimi(kurumId)
        || ogretmenParentOkuma(kurumId);
      allow write: if platformAdmin()
        || (kullaniciBilgisi().rol == 'kurum_admin'
            && (kullaniciBilgisi().kurumId == kurumId
                || kullaniciBilgisi().kurumId == resource.data.rootKurumId
                || kullaniciBilgisi().kurumId == resource.data.parentId));
    }

    match /kurumlar/{kurumId}/siniflar/{sinifId} {
      // Öğretmen: atandığı sınıfları görebilir
      allow read:  if kurumUyesi(kurumId) || platformAdmin()
                   || ogretmenSinifErisimi(kurumId, sinifId);
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }

    match /kurumlar/{kurumId}/ogrenciler/{ogrenciId} {
      // Öğretmen: atandığı sınıftaki öğrencileri görebilir
      allow read:  if kurumUyesi(kurumId) || platformAdmin()
                   || (kullaniciBilgisi().rol == 'ogretmen'
                       && kurumId in kullaniciBilgisi().get('erisimKurumIdler', [])
                       && resource.data.sinifId in kullaniciBilgisi().get('sinifIdler', []));
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }

    match /kurumlar/{kurumId}/moduller/{modulId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin()
                   || ogretmenKurumErisimi(kurumId);
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }

    // Platform rubrikleri: herkes okuyabilir, sadece platform admin yazar
    match /rubrikSablonlar/{sablonId} {
      allow read:  if request.auth != null;
      allow write: if platformAdmin();
    }

    // Kurum rubrikleri:
    // OKUMA  → aynı organizasyon + öğretmen kendi erişim kurumlarından
    // YAZMA  → tam eşleşen kurum sahibi veya platformAdmin
    //          koordinatör (ogretmen + rubrik_olustur) kendi kurumuna yazabilir
    match /kurumlar/{kurumId}/rubrikler/{rubrikId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin()
                   || ayniOrganizasyon(kurumId)
                   || ogretmenKurumErisimi(kurumId);
      allow write: if platformAdmin()
                   || (kullaniciBilgisi().rol == 'kurum_admin'
                       && kullaniciBilgisi().kurumId == kurumId)
                   || (kullaniciBilgisi().rol == 'ogretmen'
                       && kullaniciBilgisi().get('modulIzinler', {}).get('rubrik_olustur', false)
                       && kullaniciBilgisi().kurumId == kurumId);
    }

    match /kurumlar/{kurumId}/puanlar/{kayitId} {
      allow read:   if kurumUyesi(kurumId) || platformAdmin()
                    || ogretmenKurumErisimi(kurumId);
      allow create: if kurumUyesi(kurumId) || platformAdmin()
                    || ogretmenKurumErisimi(kurumId);
      allow update: if kurumUyesi(kurumId) || platformAdmin()
                    || ogretmenKurumErisimi(kurumId);
    }

    match /kurumlar/{kurumId}/degerlendirmeler/{kayitId} {
      // OKUMA: kurum üyesi veya o kuruma atanmış öğretmen
      allow read:   if kurumUyesi(kurumId) || platformAdmin()
                    || ogretmenKurumErisimi(kurumId);
      // YAZMA: kurum admin + atanmış öğretmen (sadece kendi sınıfına)
      allow create: if kurumUyesi(kurumId) || platformAdmin()
                    || (kullaniciBilgisi().rol == 'ogretmen'
                        && kurumId in kullaniciBilgisi().get('erisimKurumIdler', [])
                        && request.resource.data.sinifId in kullaniciBilgisi().get('sinifIdler', []));
      allow update: if kurumUyesi(kurumId) || platformAdmin()
                    || (kullaniciBilgisi().rol == 'ogretmen'
                        && kurumId in kullaniciBilgisi().get('erisimKurumIdler', [])
                        && resource.data.sinifId in kullaniciBilgisi().get('sinifIdler', []));
    }

    match /kurumlar/{kurumId}/yorumlar/{yorumId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin()
                   || ogretmenKurumErisimi(kurumId);
      allow write: if kurumUyesi(kurumId) || platformAdmin()
                   || ogretmenKurumErisimi(kurumId);
    }

    match /kurumlar/{kurumId}/raporlar/{raporId} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin()
                   || ogretmenKurumErisimi(kurumId);
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }

    match /kurumlar/{kurumId}/kullanicilar/{uid} {
      allow read:  if kurumUyesi(kurumId) || platformAdmin();
      allow write: if kurumAdmin(kurumId) || platformAdmin();
    }
  }
}
